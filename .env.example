# Application
APP_ENV=development
APP_NAME="AI E-Learning Platform"
API_PREFIX=/api
SECRET_KEY=replace-with-a-local-secret
ACCESS_TOKEN_EXPIRE_SECONDS=900
REFRESH_TOKEN_EXPIRE_DAYS=7
APP_TIMEZONE=Asia/Ho_Chi_Minh
CORS_ORIGINS=["http://localhost:3000"]

# PostgreSQL + pgvector (AWS RDS in staging/production)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/elearning
DATABASE_URL_SYNC=postgresql+psycopg2://postgres:postgres@localhost:5432/elearning
TEST_DATABASE_URL=
TEST_DATABASE_URL_SYNC=

# Amazon S3 + CloudFront
AWS_REGION=ap-southeast-1
STORAGE_ENDPOINT_URL=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
S3_BUCKET_NAME=elearning-media
S3_PUBLIC_BASE_URL=
CLOUDFRONT_DOMAIN=

# AI adapters
OPENAI_API_KEY=
GEMINI_API_KEY=
AI_PRIMARY_MODEL=gpt-4o-mini
AI_FALLBACK_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# Whisper worker
WHISPER_MODEL_SIZE=small
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=int8
WHISPER_BEAM_SIZE=5
WHISPER_VAD_FILTER=true
WHISPER_LANGUAGE=vi

# PayOS
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=

# SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=
