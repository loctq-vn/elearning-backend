[Unit]
Description=E-Learning FastAPI Backend Service
After=network.target

[Service]
Type=simple
User=ec2-user
WorkingDirectory=/home/ec2-user/elearning-backend
Environment=PYTHONPATH=/home/ec2-user/elearning-backend
ExecStart=/home/ec2-user/elearning-backend/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000 --workers 2
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
